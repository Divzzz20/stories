{
  "name": "webpe-stories",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "nodemon server/server.js",
    "client": "npm start --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client",
    "prod": "NODE_ENV=production node server/server.js",
    "prod-windows": "set NODE_ENV=production && node server/server.js",
    "heroku-postbuild": "NPM_CONFIG_PRODUCTION=false npm install --prefix client && npm run build --prefix client",
    "install-dependencies": "npm install && npm install --prefix client && npm install --prefix server",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "mern",
    "react",
    "mongodb",
    "express",
    "webpe",
    "stories"
  ],
  "author": "",
  "license": "MIT",
  "description": "Dynamic Stories feature for WebPe application",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1"
  }
}
